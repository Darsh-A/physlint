{
  "name": "physlint",
  "displayName": "physlint",
  "description": "Physical unit consistency checking for Python",
  "version": "0.1.0",
  "publisher": "physlint",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "physlint.restart",
        "title": "physlint: Restart Server"
      },
      {
        "command": "physlint.showOutput",
        "title": "physlint: Show Output"
      }
    ],
    "configuration": {
      "title": "physlint",
      "properties": {
        "physlint.pythonPath": {
          "type": "string",
          "default": "python",
          "markdownDescription": "Path to the Python interpreter with `physlint[lsp]` installed. Leave as `python` to auto-detect from the Python extension or a local `.venv`."
        },
        "physlint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable physlint."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "npx @vscode/vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
